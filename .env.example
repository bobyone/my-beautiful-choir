# Example configuration of my-beautiful-choir. Copy it to .env (never committed)
# and adjust the values. Every key is optional; see docs/configuration.md.
# With Docker Compose, .env is read automatically. Without it, export the
# variables in your shell or in your MCP client configuration.

# Running mode: personal (stdio) or web (HTTP).
# Ignored by Docker Compose, which always runs web mode.
MBC_MODE=personal

# Minimum log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
MBC_LOG_LEVEL=INFO

# Personal mode: directory of the database and the scores. Empty means the
# user data directory of the platform (see docs/configuration.md).
MBC_DATA_DIR=

# Personal mode: optional absolute path for a custom Audiveris installation.
MBC_RECOGNITION__AUDIVERIS_EXECUTABLE=
# Maximum duration of one recognition process, in seconds.
MBC_RECOGNITION__TIMEOUT_SECONDS=600

# Web mode: address and port to listen on.
# Ignored by Docker Compose, which listens on 0.0.0.0:9000 inside the container
# and publishes the port on 127.0.0.1:9000 only.
MBC_WEB__HOST=127.0.0.1
MBC_WEB__PORT=9000

# Web mode: comma-separated host:port values accepted in the Host header
# (protection against DNS rebinding); empty means the local host only.
MBC_WEB__ALLOWED_HOSTS=
